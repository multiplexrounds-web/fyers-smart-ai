{
  "expo": {
    "name": "Vgrow",
    "slug": "vgrow",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/WhatsApp Image 2026-11-22 at 9.10.43 PM.jpeg",
    "splash": {
      "image": "./assets/WhatsApp Image 2026-11-22 at 9.10.43 PM.jpeg",
      "resizeMode": "contain",
      "backgroundColor": "#090A0D"
    },
    "android": {
      "package": "com.multiplexrounds.fyerssmartai",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/WhatsApp Image 2026-11-22 at 9.10.43 PM.jpeg",
        "backgroundColor": "#090A0D"
      }
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "sounds": [
            "./assets/sounds/ai_trade.wav",
            "./assets/sounds/breakout.wav",
            "./assets/sounds/option_chain.wav",
            "./assets/sounds/support_resistance.wav",
            "./assets/sounds/market_sentiment.wav",
            "./assets/sounds/scalping.wav"
          ]
        }
      ],
      "expo-background-task"
